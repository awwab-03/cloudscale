# ======================= Cognito =======================
resource "aws_cognito_user_pool" "main" {
  name                     = "${var.name_prefix}-users"
  username_attributes      = ["email"]
  auto_verified_attributes = ["email"]

  password_policy {
    minimum_length    = 8
    require_lowercase = true
    require_uppercase = true
    require_numbers   = true
    require_symbols   = false
  }

  account_recovery_setting {
    recovery_mechanism {
      name     = "verified_email"
      priority = 1
    }
  }

  verification_message_template {
    default_email_option = "CONFIRM_WITH_CODE"
    email_subject        = "CloudScale Lost & Found verification code"
    email_message        = "Your CloudScale verification code is {####}"
  }

  tags = { Name = "${var.name_prefix}-users" }
}

# No client secret: Flask calls SignUp / ConfirmSignUp / InitiateAuth server-side.
resource "aws_cognito_user_pool_client" "app" {
  name         = "${var.name_prefix}-app"
  user_pool_id = aws_cognito_user_pool.main.id

  generate_secret = false
  explicit_auth_flows = [
    "ALLOW_USER_PASSWORD_AUTH",
    "ALLOW_REFRESH_TOKEN_AUTH",
  ]
  prevent_user_existence_errors = "ENABLED"
}

# ======================= App secret key (SSM SecureString) =======================
# Generated by Terraform; never written to a file or Git (value lives only in local, gitignored state).
resource "random_password" "app_secret_key" {
  length  = 48
  special = false
}

resource "aws_ssm_parameter" "app_secret_key" {
  name  = "/cloudscale/app-secret-key"
  type  = "SecureString"
  value = random_password.app_secret_key.result

  tags = { Name = "${var.name_prefix}-app-secret-key" }
}

# ======================= App log group =======================
resource "aws_cloudwatch_log_group" "app" {
  name              = "/cloudscale/app"
  retention_in_days = 7

  tags = { Name = "${var.name_prefix}-app-logs" }
}

# ======================= EC2 app role =======================
locals {
  # Names fixed here; later bolts (messaging, ml) must create resources with exactly these names.
  claim_topic_arn   = "arn:aws:sns:${var.region}:${local.account_id}:claim-notifications"
  sm_endpoint_arn   = "arn:aws:sagemaker:${var.region}:${local.account_id}:endpoint/cloudscale-category"
  nova_profile_arn  = "arn:aws:bedrock:${var.region}:${local.account_id}:inference-profile/us.amazon.nova-micro-v1:0"
  nova_model_arns   = [for r in ["us-east-1", "us-east-2", "us-west-2"] : "arn:aws:bedrock:${r}::foundation-model/amazon.nova-micro-v1:0"]
  ssm_params_arn    = "arn:aws:ssm:${var.region}:${local.account_id}:parameter/cloudscale/*"
  rds_secret_arn    = aws_db_instance.main.master_user_secret[0].secret_arn
  app_log_group_arn = aws_cloudwatch_log_group.app.arn
}

resource "aws_iam_role" "ec2_app" {
  name = "${var.name_prefix}-ec2-app"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "ec2_app_ssm" {
  role       = aws_iam_role.ec2_app.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

data "aws_iam_policy_document" "ec2_app" {
  statement {
    sid       = "ReadAppArtifacts"
    actions   = ["s3:GetObject"]
    resources = ["${aws_s3_bucket.artifacts.arn}/app/*"]
  }

  statement {
    sid       = "UploadsOriginalsReadWriteDelete"
    actions   = ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"]
    resources = ["${aws_s3_bucket.uploads.arn}/originals/*"]
  }

  statement {
    sid     = "UploadsDerivedRead"
    actions = ["s3:GetObject"]
    resources = [
      "${aws_s3_bucket.uploads.arn}/thumbnails/*",
      "${aws_s3_bucket.uploads.arn}/meta/*",
    ]
  }

  statement {
    sid       = "ReadRdsMasterSecret"
    actions   = ["secretsmanager:GetSecretValue"]
    resources = [local.rds_secret_arn]
  }

  statement {
    sid       = "ReadAppParameters"
    actions   = ["ssm:GetParameter", "ssm:GetParameters"]
    resources = [local.ssm_params_arn]
  }

  # kms:Decrypt for SecureString: Resource "*" restricted to calls made through SSM (documented in docs/iam-justification.md).
  statement {
    sid       = "DecryptSsmSecureStringViaSsmOnly"
    actions   = ["kms:Decrypt"]
    resources = ["*"]
    condition {
      test     = "StringEquals"
      variable = "kms:ViaService"
      values   = ["ssm.${var.region}.amazonaws.com"]
    }
  }

  statement {
    sid       = "ClaimNotifications"
    actions   = ["sns:Publish", "sns:Subscribe"]
    resources = [local.claim_topic_arn]
  }

  statement {
    sid       = "InvokeNovaMicro"
    actions   = ["bedrock:InvokeModel"]
    resources = concat([local.nova_profile_arn], local.nova_model_arns)
  }

  statement {
    sid       = "InvokeCategoryEndpoint"
    actions   = ["sagemaker:InvokeEndpoint"]
    resources = [local.sm_endpoint_arn]
  }

  statement {
    sid       = "WriteAppLogs"
    actions   = ["logs:CreateLogStream", "logs:PutLogEvents"]
    resources = ["${local.app_log_group_arn}:*"]
  }
}

resource "aws_iam_role_policy" "ec2_app" {
  name   = "${var.name_prefix}-ec2-app"
  role   = aws_iam_role.ec2_app.id
  policy = data.aws_iam_policy_document.ec2_app.json
}

resource "aws_iam_instance_profile" "ec2_app" {
  name = "${var.name_prefix}-ec2-app"
  role = aws_iam_role.ec2_app.name
}
